{
  "hosting": {
    "public": "tmp/uat-production-site",
    "ignore": [
      "firebase.uat.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.css", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
