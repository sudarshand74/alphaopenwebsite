rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasStoredSuperAdminRole() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'active'
        && get(userPath(request.auth.uid)).data.globalRoles is list
        && get(userPath(request.auth.uid)).data.globalRoles.hasAny(['superAdmin']);
    }

    function isActiveUser() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'active';
    }

    function hasStoredOperationsGlobalRole() {
      return isActiveUser()
        && get(userPath(request.auth.uid)).data.globalRoles is list
        && get(userPath(request.auth.uid)).data.globalRoles.hasAny([
          'superAdmin', 'ec', 'captain', 'neutralApprover'
        ]);
    }

    // Temporary bootstrap path. Replace the email check with a custom claim
    // after the first Super Admin account is provisioned by trusted code.
    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.token.get('superAdmin', false) == true
          || hasStoredSuperAdminRole()
          || (
            request.auth.token.email_verified == true
            && request.auth.token.email == 'sudarshandesai74@gmail.com'
          )
        );
    }

    function isBootstrapAdminEmail(email) {
      return email == 'sudarshandesai74@gmail.com';
    }

    function seasonMemberPath(seasonId) {
      return /databases/$(database)/documents/seasons/$(seasonId)/members/$(request.auth.uid);
    }

    function isSeasonMember(seasonId) {
      return signedIn()
        && exists(seasonMemberPath(seasonId))
        && get(seasonMemberPath(seasonId)).data.status == 'active';
    }

    function seasonMember(seasonId) {
      return get(seasonMemberPath(seasonId)).data;
    }

    function hasSeasonRole(seasonId, role) {
      return isSeasonMember(seasonId)
        && seasonMember(seasonId).roles is list
        && seasonMember(seasonId).roles.hasAny([role]);
    }

    function activeSeasonControlPath() {
      return /databases/$(database)/documents/systemConfig/seasonControl;
    }

    function hasCurrentSeasonOperationsRole() {
      return isActiveUser()
        && exists(activeSeasonControlPath())
        && get(activeSeasonControlPath()).data.activeSeasonId is string
        && (
          hasSeasonRole(get(activeSeasonControlPath()).data.activeSeasonId, 'captain')
          || hasSeasonRole(get(activeSeasonControlPath()).data.activeSeasonId, 'ec')
          || hasSeasonRole(get(activeSeasonControlPath()).data.activeSeasonId, 'neutralApprover')
        );
    }

    function hasOperationsAccess() {
      return isSuperAdmin()
        || hasStoredOperationsGlobalRole()
        || hasCurrentSeasonOperationsRole();
    }

    function isSeasonEC(seasonId) {
      return isSuperAdmin() || hasSeasonRole(seasonId, 'ec');
    }

    function isCaptainForTeam(seasonId, teamId) {
      return isSeasonMember(seasonId)
        && seasonMember(seasonId).get('roles', []).hasAny(['captain'])
        && seasonMember(seasonId).get('teamIds', []).hasAny([teamId]);
    }

    function matchupPath(seasonId, matchupId) {
      return /databases/$(database)/documents/seasons/$(seasonId)/matchups/$(matchupId);
    }

    function matchupExists(seasonId, matchupId) {
      return exists(matchupPath(seasonId, matchupId));
    }

    function matchup(seasonId, matchupId) {
      return get(matchupPath(seasonId, matchupId)).data;
    }

    function isPublicMatchStatus(line) {
      return line.scheduleStatus in ['toBeScheduled', 'scheduled', 'completed'];
    }

    function seasonApproverPath(seasonId) {
      return /databases/$(database)/documents/seasons/$(seasonId)/approverAssignments/$(request.auth.uid);
    }

    function isSeasonApprover(seasonId) {
      return isActiveUser()
        && (
          (
            exists(seasonApproverPath(seasonId))
            && get(seasonApproverPath(seasonId)).data.status == 'active'
            && get(seasonApproverPath(seasonId)).data.approverUid == request.auth.uid
          )
          || hasSeasonRole(seasonId, 'neutralApprover')
        );
    }

    function isMatchupTeamCaptain(seasonId, matchupId) {
      return matchupExists(seasonId, matchupId)
        && (
          isCaptainForTeam(seasonId, matchup(seasonId, matchupId).homeTeamId)
          || isCaptainForTeam(seasonId, matchup(seasonId, matchupId).awayTeamId)
        );
    }

    function lineupPath(seasonId, matchupId, teamId) {
      return /databases/$(database)/documents/seasons/$(seasonId)/matchups/$(matchupId)/lineups/$(teamId);
    }

    function canSubmitLineup(seasonId, matchupId, teamId) {
      return matchupExists(seasonId, matchupId)
        && (
          matchup(seasonId, matchupId).homeTeamId == teamId
          || matchup(seasonId, matchupId).awayTeamId == teamId
        )
        && (
          isSuperAdmin()
          || matchup(seasonId, matchupId).get('approverUids', []).hasAny([request.auth.uid])
          || isSeasonEC(seasonId)
          || isSeasonApprover(seasonId)
          || isCaptainForTeam(seasonId, teamId)
        );
    }

    function canReviewLineup(seasonId, matchupId) {
      return isSuperAdmin()
        || (
          matchupExists(seasonId, matchupId)
          && matchup(seasonId, matchupId).get('approverUids', []).hasAny([request.auth.uid])
        )
        || isSeasonApprover(seasonId);
    }

    function isWorkflowActor(seasonId, matchupId) {
      return signedIn()
        && getAfter(matchupPath(seasonId, matchupId)).data.lineupWorkflowActorUid == request.auth.uid;
    }

    function lineupStatusMatchesMatchup(seasonId, matchupId, teamId, status) {
      return (
          getAfter(matchupPath(seasonId, matchupId)).data.homeTeamId == teamId
          && getAfter(matchupPath(seasonId, matchupId)).data.homeLineupStatus == status
        )
        || (
          getAfter(matchupPath(seasonId, matchupId)).data.awayTeamId == teamId
          && getAfter(matchupPath(seasonId, matchupId)).data.awayLineupStatus == status
        );
    }

    function validLineupApprovalState(data) {
      return (
          (data.homeLineupStatus == 'rejected' || data.awayLineupStatus == 'rejected')
          && data.lineupApprovalStatus == 'rejected'
        )
        || (
          data.homeLineupStatus == 'approved'
          && data.awayLineupStatus == 'approved'
          && data.lineupApprovalStatus == 'fullyApproved'
        )
        || (
          data.homeLineupStatus in ['submitted', 'approved']
          && data.awayLineupStatus in ['submitted', 'approved']
          && !(data.homeLineupStatus == 'approved' && data.awayLineupStatus == 'approved')
          && data.lineupApprovalStatus == 'awaitingApproval'
        )
        || (
          (data.homeLineupStatus == 'pendingSubmission' || data.awayLineupStatus == 'pendingSubmission')
          && data.homeLineupStatus != 'rejected'
          && data.awayLineupStatus != 'rejected'
          && data.lineupApprovalStatus == 'awaitingSubmission'
        );
    }

    function matchupWorkflowKeys() {
      return [
        'homeLineupStatus', 'awayLineupStatus',
        'homeLineupRevisionNumber', 'awayLineupRevisionNumber',
        'homeLineupTracking', 'awayLineupTracking',
        'lineupApprovalStatus', 'bothLineupsSubmitted',
        'lineupsPublished', 'lineupsPublishedAt', 'fullyApprovedAt',
        'approvalCycleNumber', 'lastLineupReset',
        'lineupWorkflowActorUid', 'lineupWorkflowOperationId', 'updatedAt'
      ];
    }

    function workflowMatchupUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(matchupWorkflowKeys())
        && validLineupApprovalState(request.resource.data);
    }

    match /users/{uid} {
      allow create: if signedIn() && isSuperAdmin();
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow update: if (isSuperAdmin() && !isBootstrapAdminEmail(resource.data.email))
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoUrl', 'lastLoginAt', 'updatedAt'
          ]))
        || (signedIn()
          && request.auth.uid == uid
          && isBootstrapAdminEmail(request.auth.token.email)
          && isBootstrapAdminEmail(resource.data.email)
          && request.resource.data.email == resource.data.email
          && request.resource.data.status == 'active'
          && request.resource.data.profileType == 'superAdmin'
          && request.resource.data.playerId == 'P1200'
          && request.resource.data.globalRoles is list
          && request.resource.data.globalRoles.size() == 1
          && request.resource.data.globalRoles.hasAny(['superAdmin'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoUrl', 'lastLoginAt', 'updatedAt',
            'status', 'profileType', 'playerId', 'globalRoles'
          ]));
      allow delete: if isSuperAdmin() && !isBootstrapAdminEmail(resource.data.email);

      match /notifications/{notificationId} {
        allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    match /players/{playerId} {
      allow read: if isSuperAdmin()
        || hasOperationsAccess()
        || (resource.data.status == 'active' && resource.data.publicProfileEnabled == true);
      allow write: if isSuperAdmin();
    }

    match /playerPrivate/{playerId} {
      allow read, write: if isSuperAdmin();
    }

    match /playerEmailIndex/{emailKey} {
      allow get: if isSuperAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && resource.data.emailNormalized.lower() == request.auth.token.email.lower());
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /systemCounters/{counterId} {
      allow read, write: if isSuperAdmin();
    }

    match /playerAccountLinks/{playerId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isSuperAdmin();
    }

    match /playerLinkRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requestingUid == request.auth.uid
        && request.resource.data.verifiedEmail == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.requestingUid == request.auth.uid);
      allow update: if isSuperAdmin()
        || (signedIn()
          && resource.data.requestingUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if false;
    }

    match /registrationRequests/{uid} {
      allow create: if isSuperAdmin();
      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.uid == uid);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /venues/{venueId} {
      allow read: if signedIn() || resource.data.active == true;
      allow write: if isSuperAdmin();
    }

    match /venuePrivate/{venueId} {
      allow read, write: if isSuperAdmin();
    }

    match /systemConfig/{documentId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // Guest-safe projection metadata. Clients read one small version document
    // before deciding whether the locally cached public Player Master is stale.
    match /publicConfig/{documentId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (documentId == 'activeSeasonDashboard'
          && request.resource.data.seasonId is string
          && isSeasonEC(request.resource.data.seasonId));
    }

    match /publicSeasonDashboards/{seasonId} {
      allow read: if resource.data.status == 'completed';
      allow create, update: if isSuperAdmin() || isSeasonEC(seasonId);
      allow delete: if isSuperAdmin();
    }

    match /publicCompletedSeasons/{seasonId} {
      allow read: if resource.data.status == 'completed';
      allow create, update: if isSuperAdmin() || isSeasonEC(seasonId);
      allow delete: if isSuperAdmin();
    }

    match /aoContent/{contentId} {
      allow get: if resource.data.status == 'active' || isSuperAdmin();
      allow list: if isSuperAdmin() || resource.data.status == 'active';
      allow create, update, delete: if isSuperAdmin();
    }

    match /aoFaqCategories/{categoryId} {
      allow get: if resource.data.status == 'active' || isSuperAdmin();
      allow list: if isSuperAdmin() || resource.data.status == 'active';
      allow create, update, delete: if isSuperAdmin();
    }

    match /aoFaqs/{faqId} {
      allow get: if resource.data.status == 'active' || isSuperAdmin();
      allow list: if isSuperAdmin() || resource.data.status == 'active';
      allow create, update, delete: if isSuperAdmin();
    }

    match /seasons/{seasonId} {
      allow read: if isSuperAdmin() || isSeasonMember(seasonId) || isSeasonApprover(seasonId);
      allow write: if isSuperAdmin();

      match /ruleVersions/{ruleVersionId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId);
        allow write: if isSuperAdmin();
      }

      match /members/{uid} {
        allow read: if isSuperAdmin()
          || isSeasonEC(seasonId)
          || (signedIn() && request.auth.uid == uid);
        allow write: if isSuperAdmin();
      }

      match /teams/{teamId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId) || isSeasonApprover(seasonId);
        allow write: if isSeasonEC(seasonId);
      }

      match /rosterSlots/{slotId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId);
        allow write: if isSeasonEC(seasonId);
      }

      match /rosterAssignments/{assignmentId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId) || isSeasonApprover(seasonId);
        allow write: if isSeasonEC(seasonId);
      }

      match /weeks/{weekId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId) || isSeasonApprover(seasonId);
        allow write: if isSeasonEC(seasonId);
      }

      match /importAudits/{importId} {
        allow read, write: if isSuperAdmin();
      }

      match /matchups/{matchupId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId) || isSeasonApprover(seasonId);
        allow create, delete: if isSuperAdmin();
        allow update: if isSuperAdmin();
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'homeTeamPoints', 'awayTeamPoints', 'completedLineCount',
            'canceledLineCount', 'status', 'winnerTeamId',
            'lastCorrectionId', 'lastCorrectionAt', 'lastCorrectionByUid',
            'updatedAt'
          ])
          && request.resource.data.lastCorrectionByUid == request.auth.uid
          && isSeasonEC(seasonId);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'homeTeamPoints', 'awayTeamPoints', 'completedLineCount',
            'canceledLineCount', 'status', 'winnerTeamId', 'standingsApplied',
            'derivedRecordsUpdatedAt', 'derivedRecordsUpdatedByUid', 'updatedAt'
          ])
          && request.resource.data.derivedRecordsUpdatedByUid == request.auth.uid
          && isSeasonEC(seasonId);
        allow update: if request.resource.data.homeLineupStatus == 'submitted'
          && request.resource.data.awayLineupStatus == resource.data.awayLineupStatus
          && workflowMatchupUpdateOnly()
          && canSubmitLineup(seasonId, matchupId, resource.data.homeTeamId)
          && existsAfter(lineupPath(seasonId, matchupId, resource.data.homeTeamId))
          && getAfter(lineupPath(seasonId, matchupId, resource.data.homeTeamId)).data.status == 'submitted'
          && getAfter(lineupPath(seasonId, matchupId, resource.data.homeTeamId)).data.submittedByUid == request.auth.uid;
        allow update: if request.resource.data.awayLineupStatus == 'submitted'
          && request.resource.data.homeLineupStatus == resource.data.homeLineupStatus
          && workflowMatchupUpdateOnly()
          && canSubmitLineup(seasonId, matchupId, resource.data.awayTeamId)
          && existsAfter(lineupPath(seasonId, matchupId, resource.data.awayTeamId))
          && getAfter(lineupPath(seasonId, matchupId, resource.data.awayTeamId)).data.status == 'submitted'
          && getAfter(lineupPath(seasonId, matchupId, resource.data.awayTeamId)).data.submittedByUid == request.auth.uid;
        allow update: if request.resource.data.homeLineupStatus in ['approved', 'rejected']
          && request.resource.data.awayLineupStatus == resource.data.awayLineupStatus
          && workflowMatchupUpdateOnly()
          && canReviewLineup(seasonId, matchupId)
          && getAfter(lineupPath(seasonId, matchupId, resource.data.homeTeamId)).data.status
            == request.resource.data.homeLineupStatus;
        allow update: if request.resource.data.awayLineupStatus in ['approved', 'rejected']
          && request.resource.data.homeLineupStatus == resource.data.homeLineupStatus
          && workflowMatchupUpdateOnly()
          && canReviewLineup(seasonId, matchupId)
          && getAfter(lineupPath(seasonId, matchupId, resource.data.awayTeamId)).data.status
            == request.resource.data.awayLineupStatus;
        allow update: if resource.data.lineupApprovalStatus == 'fullyApproved'
          && request.resource.data.homeLineupStatus == 'pendingSubmission'
          && request.resource.data.awayLineupStatus == 'pendingSubmission'
          && request.resource.data.lineupApprovalStatus == 'awaitingSubmission'
          && workflowMatchupUpdateOnly()
          && canReviewLineup(seasonId, matchupId)
          && request.resource.data.lastLineupReset.resetByUid == request.auth.uid
          && !existsAfter(lineupPath(seasonId, matchupId, resource.data.homeTeamId))
          && !existsAfter(lineupPath(seasonId, matchupId, resource.data.awayTeamId));

        match /lineups/{teamId} {
          function lineupPublished() {
            return matchupExists(seasonId, matchupId)
              && matchup(seasonId, matchupId).lineupsPublished == true;
          }

          function approverCanReview() {
            return canReviewLineup(seasonId, matchupId);
          }

          allow read: if isSeasonEC(seasonId)
            || isCaptainForTeam(seasonId, teamId)
            || approverCanReview()
            || (isSeasonMember(seasonId) && lineupPublished());

          allow create: if request.resource.data.status == 'draft'
            && request.resource.data.teamId == teamId
            && canSubmitLineup(seasonId, matchupId, teamId);
          allow create: if request.resource.data.status == 'submitted'
            && request.resource.data.teamId == teamId
            && lineupStatusMatchesMatchup(seasonId, matchupId, teamId, 'submitted')
            && request.resource.data.submittedByUid == request.auth.uid
            && request.resource.data.updatedByUid == request.auth.uid
            && request.resource.data.revisionNumber > 0
            && request.resource.data.lines is list
            && request.resource.data.lines.size() == 5
            && isWorkflowActor(seasonId, matchupId);
          allow update: if request.resource.data.status == 'draft'
            && resource.data.status in ['draft', 'validationFailed', 'systemValidated', 'changesRequested', 'rejected']
            && request.resource.data.teamId == teamId
            && canSubmitLineup(seasonId, matchupId, teamId);
          allow update: if request.resource.data.status == 'submitted'
            && resource.data.status in ['draft', 'validationFailed', 'systemValidated', 'changesRequested', 'rejected']
            && request.resource.data.teamId == teamId
            && lineupStatusMatchesMatchup(seasonId, matchupId, teamId, 'submitted')
            && request.resource.data.submittedByUid == request.auth.uid
            && request.resource.data.updatedByUid == request.auth.uid
            && request.resource.data.revisionNumber > resource.data.revisionNumber
            && request.resource.data.lines is list
            && request.resource.data.lines.size() == 5
            && isWorkflowActor(seasonId, matchupId);
          allow update: if request.resource.data.status in ['approved', 'rejected']
            && resource.data.status in ['submitted', 'approved']
            && lineupStatusMatchesMatchup(
              seasonId, matchupId, teamId, request.resource.data.status
            )
            && request.resource.data.teamId == teamId
            && request.resource.data.revisionNumber == resource.data.revisionNumber
            && request.resource.data.lines == resource.data.lines
            && request.resource.data.updatedByUid == request.auth.uid
            && (
              (
                request.resource.data.status == 'approved'
                && request.resource.data.approvedByUid == request.auth.uid
              )
              || (
                request.resource.data.status == 'rejected'
                && request.resource.data.rejectedByUid == request.auth.uid
                && request.resource.data.rejectionReason is string
                && request.resource.data.rejectionReason.size() > 0
              )
            )
            && isWorkflowActor(seasonId, matchupId);
          allow delete: if isWorkflowActor(seasonId, matchupId)
            && resource.data.status == 'approved'
            && getAfter(matchupPath(seasonId, matchupId)).data.lineupApprovalStatus == 'awaitingSubmission'
            && getAfter(matchupPath(seasonId, matchupId)).data.homeLineupStatus == 'pendingSubmission'
            && getAfter(matchupPath(seasonId, matchupId)).data.awayLineupStatus == 'pendingSubmission';

          match /revisions/{revisionId} {
            allow read: if isSeasonEC(seasonId)
              || isCaptainForTeam(seasonId, teamId)
              || approverCanReview()
              || (isSeasonMember(seasonId) && lineupPublished());
            allow create: if request.resource.data.status == 'submitted'
              && request.resource.data.teamId == teamId
              && lineupStatusMatchesMatchup(seasonId, matchupId, teamId, 'submitted')
              && request.resource.data.immutable == true
              && request.resource.data.submittedByUid == request.auth.uid
              && request.resource.data.updatedByUid == request.auth.uid
              && request.resource.data.lines is list
              && request.resource.data.lines.size() == 5
              && isWorkflowActor(seasonId, matchupId);
            allow update, delete: if false;
          }
        }

        match /lineupReviews/{reviewId} {
          allow read: if isSeasonEC(seasonId)
            || canReviewLineup(seasonId, matchupId)
            || isMatchupTeamCaptain(seasonId, matchupId);
          allow create: if request.resource.data.action in [
              'submitted', 'approved', 'rejected', 'approvalReopened', 'resetBothApprovedLineups'
            ]
            && request.resource.data.operationId == reviewId
            && request.resource.data.actedByUid == request.auth.uid
            && getAfter(matchupPath(seasonId, matchupId)).data.lineupWorkflowOperationId == reviewId
            && isWorkflowActor(seasonId, matchupId);
          allow update, delete: if false;
        }

        match /lineMatches/{lineMatchId} {
          allow read: if isSuperAdmin()
            || isSeasonMember(seasonId)
            || isSeasonApprover(seasonId)
            || isPublicMatchStatus(resource.data);
          allow create: if request.resource.data.lineMatchId == lineMatchId
            && request.resource.data.lineupState == 'approved'
            && request.resource.data.scoreEntryAllowed == true
            && getAfter(matchupPath(seasonId, matchupId)).data.lineupApprovalStatus == 'fullyApproved'
            && isWorkflowActor(seasonId, matchupId);
          allow delete: if isSuperAdmin();
          allow update: if isSuperAdmin();
          allow update: if isWorkflowActor(seasonId, matchupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lineMatchId', 'lineupId', 'seasonId', 'matchupId', 'lineNumber',
              'homeTeamId', 'awayTeamId', 'homePlayers', 'awayPlayers',
              'homeSor', 'awaySor', 'homeLineupRevisionNumber', 'awayLineupRevisionNumber',
              'lineupState', 'scoreEntryAllowed', 'updatedAt'
            ])
            && getAfter(matchupPath(seasonId, matchupId)).data.lineupApprovalStatus == 'fullyApproved'
            && request.resource.data.lineupState == 'approved'
            && request.resource.data.scoreEntryAllowed == true;
          allow update: if isWorkflowActor(seasonId, matchupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lineupState', 'scoreEntryAllowed', 'updatedAt'
            ])
            && getAfter(matchupPath(seasonId, matchupId)).data.lineupApprovalStatus == 'awaitingSubmission'
            && request.resource.data.lineupState == 'awaitingReapproval'
            && request.resource.data.scoreEntryAllowed == false;
          allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'homePlayers', 'awayPlayers', 'homeSor', 'awaySor',
                'venueId', 'venueNameSnapshot', 'venueAddressSnapshot',
                'scheduledAt', 'sets', 'scheduleStatus', 'scoreStatus',
                'homePoints', 'awayPoints', 'winnerTeamId',
                'lineupState', 'scoreEntryAllowed',
                'lastCorrectionId', 'lastCorrectionAt', 'lastCorrectionByUid',
                'lastCorrectionByNameSnapshot', 'lastCorrectionReason', 'updatedAt'
              ])
              && request.resource.data.lastCorrectionByUid == request.auth.uid
              && request.resource.data.lastCorrectionReason is string
              && request.resource.data.lastCorrectionReason.size() > 0
              && isSeasonEC(seasonId))
            || (isMatchupTeamCaptain(seasonId, matchupId)
              && resource.data.scheduleStatus in ['toBeScheduled', 'scheduled']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'venueId', 'venueNameSnapshot', 'venueAddressSnapshot', 'scheduledAt', 'sets',
                'scheduleStatus', 'scoreStatus', 'homePoints', 'awayPoints',
                'winnerTeamId', 'updatedAt'
              ]));

          match /playerOverrides/{overrideId} {
            allow read: if isSuperAdmin();
            allow create: if isSuperAdmin()
              && request.resource.data.overrideId == overrideId
              && request.resource.data.seasonId == seasonId
              && request.resource.data.matchupId == matchupId
              && request.resource.data.lineMatchId == lineMatchId
              && request.resource.data.reason is string
              && request.resource.data.reason.size() > 0;
            allow update, delete: if false;
          }

          match /corrections/{correctionId} {
            allow read: if isSeasonEC(seasonId);
            allow create: if isSeasonEC(seasonId)
              && request.resource.data.correctionId == correctionId
              && request.resource.data.seasonId == seasonId
              && request.resource.data.matchupId == matchupId
              && request.resource.data.lineMatchId == lineMatchId
              && request.resource.data.correctedByUid == request.auth.uid
              && request.resource.data.reason is string
              && request.resource.data.reason.size() > 0;
            allow update, delete: if false;
          }

          match /scheduleProposals/{proposalId} {
            allow read: if isSeasonEC(seasonId) || isMatchupTeamCaptain(seasonId, matchupId);
            allow create: if isMatchupTeamCaptain(seasonId, matchupId)
              && request.resource.data.proposedByUid == request.auth.uid;
            allow update: if isSeasonEC(seasonId) || isMatchupTeamCaptain(seasonId, matchupId);
            allow delete: if false;
          }

          match /scoreSubmissions/{submissionId} {
            allow read: if isSeasonEC(seasonId) || isMatchupTeamCaptain(seasonId, matchupId);
            allow create: if isMatchupTeamCaptain(seasonId, matchupId)
              && request.resource.data.submittedByUid == request.auth.uid;
            allow update, delete: if false;
          }

          match /scoreDecisions/{decisionId} {
            allow read: if isSeasonEC(seasonId) || isMatchupTeamCaptain(seasonId, matchupId);
            allow write: if false;
          }
        }
      }

      match /approverAssignments/{assignmentId} {
        allow read: if isSeasonEC(seasonId)
          || (
            signedIn()
            && (
              assignmentId == request.auth.uid
              || assignmentId == 'season_' + request.auth.uid
            )
          )
          || (signedIn() && resource.data.approverUid == request.auth.uid)
          || (signedIn() && resource.data.get('backupApproverUid', '') == request.auth.uid);
        allow write: if isSuperAdmin();
      }

      match /availability/{availabilityId} {
        allow read: if isSeasonEC(seasonId)
          || (signedIn() && resource.data.playerUid == request.auth.uid)
          || isCaptainForTeam(seasonId, resource.data.teamId);
        allow create: if isSeasonMember(seasonId)
          && request.resource.data.playerUid == request.auth.uid;
        allow update: if isSeasonEC(seasonId)
          || (signedIn()
            && resource.data.playerUid == request.auth.uid
            && request.resource.data.playerUid == request.auth.uid);
        allow delete: if false;
      }

      match /replacementRequests/{requestId} {
        allow read: if isSeasonEC(seasonId)
          || isCaptainForTeam(seasonId, resource.data.teamId);
        allow create: if isCaptainForTeam(seasonId, request.resource.data.teamId)
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isSeasonEC(seasonId);
        allow delete: if false;
      }

      match /latePassRequests/{requestId} {
        allow read: if isSeasonEC(seasonId)
          || isCaptainForTeam(seasonId, resource.data.teamId);
        allow create: if isCaptainForTeam(seasonId, request.resource.data.teamId)
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isSeasonEC(seasonId);
        allow delete: if false;
      }

      match /adjustments/{adjustmentId} {
        allow read: if isSeasonEC(seasonId);
        allow write: if isSuperAdmin();
      }

      match /standings/{teamId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId);
        allow create: if request.resource.data.teamId == teamId
          && request.resource.data.calculatedByUid == request.auth.uid
          && request.resource.data.keys().hasAll([
            'teamId', 'completedMatchups', 'completedLines', 'lineWins',
            'lineLosses', 'matchPoints', 'bonusPoints', 'penaltyPoints',
            'adjustedTotal', 'playoffPosition', 'qualified', 'calculatedAt',
            'calculatedByUid', 'sourceVersion'
          ])
          && isSeasonEC(seasonId);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'teamId', 'completedMatchups', 'completedLines', 'lineWins',
            'lineLosses', 'matchPoints', 'bonusPoints', 'penaltyPoints',
            'adjustedTotal', 'playoffPosition', 'qualified', 'calculatedAt',
            'calculatedByUid', 'sourceVersion'
          ])
          && request.resource.data.teamId == teamId
          && request.resource.data.calculatedByUid == request.auth.uid
          && isSeasonEC(seasonId);
        allow delete: if false;
      }

      match /standingsSnapshots/{snapshotId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId);
        allow write: if false;
      }

      match /playoffBrackets/{bracketId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId);
        allow write: if isSeasonEC(seasonId);
      }

      match /announcements/{announcementId} {
        allow read: if isSuperAdmin() || isSeasonMember(seasonId);
        allow write: if isSeasonEC(seasonId);
      }

      match /auditEvents/{eventId} {
        allow read: if isSeasonEC(seasonId);
        allow write: if false;
      }

      // Super Admin season reset: permits deletion of known and future
      // season-scoped descendants while preserving the Season Master itself.
      match /{document=**} {
        allow delete: if isSuperAdmin();
      }
    }

    // Every collection not explicitly matched above remains inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
