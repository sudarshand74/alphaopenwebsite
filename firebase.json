{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "ALPHAOPEN_APP_SPEC.md",
      "FIRESTORE_DATA_MODEL.md",
      "test-prototype.mjs",
      "firebase-debug.log*",
      "**/*.ndjson",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      "functions",
      "functions/**",
      "scripts/**",
      "weekly-lineup-dashboard-mock/**",
      "firebase.uat.json",
      "**/.*",
      "**/node_modules/**",
      "output/**",
      "tmp/**",
      "outputs/**",
      ".artifact_runtime/**"
    ],
    "headers": [
      { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.css", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "AlphaOpen Tennis League",
        "supportEmail": "sudarshandesai74@gmail.com"
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
